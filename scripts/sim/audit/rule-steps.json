  "rules": {
    "A1": {
      "rule": "所办＝主代理：用户的助手、媒介、传信者",
      "steps": [
        {
          "scenario": "comms",
          "step": "message/relay-member-voice",
          "side": "allow"
        },
        {
          "scenario": "comms",
          "step": "message/office-voice",
          "side": "allow"
        }
      ],
      "notes": "office 以 member 之名声明的两条通路（member-voice / office-voice）都被演示；「自动唤起汇报」见 A2（无步骤）。"
    },
    "A2": {
      "rule": "有进展时自动唤起所办汇报",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "a2-progress-report",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "a2-office-notice",
          "side": "allow"
        }
      ],
      "notes": "新场景逐字演示「有进展 ⇒ 所办被告知」：r-1 写一条 progress 卡后，所办席的收件箱真的多出一条 subject=\"v5r-progress-notice\" 的通知，打开读到正文「所内写了一条进展记录，请判断是否需要对外汇报」。注意 `vibe_v5_report` 的回执里没有 wakes 字段（唤醒走邮箱，不走报告），所以证据链是 progress 卡 → 邮箱通知，不是报告计数。"
    },
    "A3": {
      "rule": "支持用户以自然语言让所办设参数、控制研究所",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "a3-set-declared-key",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "a3-set-undeclared-key",
          "side": "refuse"
        }
      ],
      "notes": "正例：office 设一个**已声明**的键 `vmu.turn.maxParallel=4`，回执带 applied/H2/appliedScope；反例：设未声明的 `vmu.r240.not-a-real-key` 被 `VMU_INVALID_ARGUMENT` 按名拒（\"unknown setting\"）。即「用户自然语言设参数」的机制面是「只收已声明键」，自然语言解析本身在提示词层。"
    },
    "A4": {
      "rule": "院士＝chair 席，统领研究所",
      "steps": [
        {
          "scenario": "mainline",
          "step": "meeting/open",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "A5": {
      "rule": "常驻研究员＝member 席",
      "steps": [
        {
          "scenario": "meetings",
          "step": "institute/start",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "A6": {
      "rule": "临时工：可被雇佣、无表决权、默认不参与会议、可解雇",
      "steps": [
        {
          "scenario": "comms",
          "step": "institute/hire-temp",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "A7": {
      "rule": "临时工可被解雇",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "a7-fire-temp",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "a7-fire-chair-refused",
          "side": "refuse"
        }
      ],
      "notes": "正例：院士 r-acad 解雇临时工 temp-1（回执 targetSeat=\"temp\"）；反例：解雇主席 r-acad 被 `VMU_NOT_PERMITTED` 按名拒（\"the academician seat is not dismissable through vibe_v5_fire\"）。注意 office 匿名调用会被 `VMU_FIRE_CALLER_UNKNOWN` 拒（调用者必须能证明人是自己雇的），所以正例必须由院士发起。"
    },
    "B1": {
      "rule": "Verified 只收 p=1 的命题",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "b2-promote-literature",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "b1-promote-unsettled",
          "side": "refuse"
        }
      ],
      "notes": "反例：p=0.9 的卡 `verified_promote` 被 `VMU_STATE` 拒（\"is not settled (p=0.9)… cannot enter the verified track\"）；正例：p=1 的文献卡同一工具写入成功（written:true, conclusion:true）⇒ Verified 只收 p=1 是闸，不是散文。"
    },
    "B2": {
      "rule": "参考文献中的命题也可直接入 Verified",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "b2-literature-route",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "b2-promote-literature",
          "side": "allow"
        }
      ],
      "notes": "正例：`record_proposition {p:1, literature_ref:\"TAOCP §4.5.1\"}` 直接拿到 `p1Route:\"literature\"`，再用 `verified_promote {warrant_kind:\"literature\"}` 直入 Verified；对比 B3：同一 p=1 若没有任何凭据就被拒。"
    },
    "B3": {
      "rule": "只有辩论能把 p 改为 1",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "b3-p1-without-warrant",
          "side": "refuse"
        }
      ],
      "notes": "反例：`record_proposition {p:1}` 不带凭据被 `VMU_PACK_V5R_P1_NEEDS_DEBATE` 拒，回执列出四条合法路 `p1Routes: [\"debate\",\"literature\",\"lean-conformance\",\"verified-row\"]`。**如实说明**：这条规则的字面「只有辩论能改 p 为 1」比机制更窄——机制真正拦的是「无凭据自封 p=1」，文献/Lean/Verified 行同样能到 p=1；本条只有拒绝侧证据，没有「辩论把 p 改成 1」的阳性步骤（E28 的裁定会下发 correction 让持卡人改值，但那一步改的是 0.85 不是 1）。"
    },
    "B4": {
      "rule": "蓝图：总目标/技术路线/规划，按时更新",
      "steps": [
        {
          "scenario": "mainline",
          "step": "blueprint/propose",
          "side": "allow"
        },
        {
          "scenario": "mainline",
          "step": "blueprint/adopt",
          "side": "allow"
        },
        {
          "scenario": "mainline",
          "step": "record/reindex",
          "side": "refuse"
        }
      ],
      "notes": "record/reindex now carries a named refusal: since RUN 259 a reindex blocks on a member plain markdown draft (VMU_RECORDS_REINDEX_BLOCKED), so the rule is evidenced by blueprint/propose and blueprint/adopt; the refused step is kept (side=refuse) because deleting it would hide that the scenario still reindexes."
    },
    "B5": {
      "rule": "蓝图由院士+常驻研究员共同设计",
      "steps": [
        {
          "scenario": "mainline",
          "step": "blueprint/codesign",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "B6": {
      "rule": "蓝图最终编辑权在院士",
      "steps": [
        {
          "scenario": "mainline",
          "step": "blueprint/adopt",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "C1": {
      "rule": "研究过程 progress 日志",
      "steps": [
        {
          "scenario": "turns",
          "step": "round-progress-string",
          "side": "allow"
        },
        {
          "scenario": "turns",
          "step": "probe-progress-shape",
          "side": "refuse"
        }
      ],
      "notes": ""
    },
    "C2": {
      "rule": "已尝试路线/方法及其进度",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c2-route-progress",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "c2-unknown-track-refused",
          "side": "refuse"
        }
      ],
      "notes": "正例：`record_progress {track:\"routes\"}` 写下已尝试路线与进度；反例：`track:\"no-such-track\"` 被 `VMU_INVALID_ARGUMENT` 拒，hint 列出全部 13 个已声明 track ⇒ 路线只有走声明的轨道才进得了库。"
    },
    "C3": {
      "rule": "遇障路线/尝试/方法及障碍与原因归档",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c3-obstacle-progress",
          "side": "allow"
        }
      ],
      "notes": "正例：`record_progress {track:\"obstacles\"}` 把遇障路线与其原因写成 obstacles 卡；回执 recordId 与后续 `read_library {track:\"obstacles\"}` 可读回。"
    },
    "C4": {
      "rule": "遇到的各种障碍及其原因（归档内容的一部分）",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c4-rejected-progress",
          "side": "allow"
        }
      ],
      "notes": "正例：`record_progress {track:\"rejected\"}` 写被否掉的尝试与原因（rejected 是 13 个已声明 track 之一），与 C3 的 obstacles 区分：障碍在 obstacles、被弃路线在 rejected。"
    },
    "C5": {
      "rule": "命题库：完整定义、p(0-1)、进度",
      "steps": [
        {
          "scenario": "paper",
          "step": "record/proposition/r-1",
          "side": "allow"
        }
      ],
      "notes": ""
    },
    "C6": {
      "rule": "平时只记证明/证伪尝试，真正会证时才写正式证明字段",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c6-card-proof-complete",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "c6-card-locked-rewrite",
          "side": "refuse"
        }
      ],
      "notes": "正例：平时写卡用 `p:0.95` + `proof_state:\"draft\"` 一类尝试口径没问题；真写完时 `proof_state:\"complete\"` + 可解析 `proof_ref` ⇒ `proofGate.locked:true`（回执明说 locked 的理由）；反例：锁后同 id 再写被 `VMU_STATE` 拒（\"card is locked: its proof was registered as complete\"）⇒ 正式证明字段一旦写完就不可改，是闸。"
    },
    "C7": {
      "rule": "只有写完的正式证明才能用于辩论",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c7-debate-with-proof",
          "side": "allow"
        },
        {
          "scenario": "rules-extra",
          "step": "c7-debate-without-proof",
          "side": "refuse"
        }
      ],
      "notes": "反例：没有证明的卡（`prop-bare`, p=0.9）开 debate 被 `VMU_PACK_V5R_DEBATE_SUBJECT_NO_PROOF` 拒，hint 给两条合法路；正例：带 `proof_state:\"complete\"` + 可解析 proof_ref 的 `prop-proof` 开 debate 成功（回执 meeting=\"m1\"、subjectGate.allowed=true）⇒ 没写完的正式证明进不了辩论。"
    },
    "C8": {
      "rule": "p=1 的命题要标记 verified",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c8-read-verified",
          "side": "allow"
        }
      ],
      "notes": "正例：辩论全一致裁决后持卡人按 correction 写 p=1，`read_library {kind:\"verified\", list:true}` 真的读到 verified 行（total:1，卡在 verified track 上带 title「已验证｜…」）⇒ p=1 的命题确实会出现在 Verified 里。这条只证「标记存在且可读」，没能证「每条 p=1 都必然被标记」——那需要更宽的语料。"
    },
    "C9": {
      "rule": "方法库（理论/方法/工具，抽象化产物）",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c9-method-record",
          "side": "allow"
        }
      ],
      "notes": "正例：`record_method {type:\"method\"}` 写入方法卡（回执 track=\"methods\"），方法库是独立的 methods track，`read_library {track:\"methods\"}` 可读回。"
    },
    "C10": {
      "rule": "Lean 代码与编译结果归档",
      "steps": [
        {
          "scenario": "rules-extra",
          "step": "c10-lean-archive-refused",
          "side": "refuse"
        }
      ],
      "notes": "**只有拒绝侧（环境事实）**：`vibe_v5_lean_archive {kind:\"proof\", from:\"Lean/OddSum.lean\"}` 被 `VMU_ENGINE_UNAVAILABLE` 拒，message 明说「需要 Lean 面，而本装配没有（宿主没注入 spawn seam）」。Lean 代码与编译结果的归档本身要实现依赖 Lean 面，本装配里没有可跑的 Lean，故无法给出「归档成功」的阳性步骤。"
    },
    "C11": {
      "rule": "lean 通过后辩论只查描述/定义是否符合原意",
      "steps": [
        {
